# Public Sanity config for the Next.js website.
# Set these in Render Environment (needed at build time AND runtime).
# Safe to expose: project ID and dataset are public read-only identifiers.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Sanity Studio only (local / hosted Studio). Not required on Render for the website.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Optional: read token for private datasets only.
# Never set write tokens (SANITY_API_WRITE_TOKEN / SANITY_AUTH_TOKEN) on Render
# or in NEXT_PUBLIC_* variables.
# SANITY_API_READ_TOKEN=
