# Sanity CMS (public read-only config — safe for frontend)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Sanity Studio (copy the same values into sanity/.env)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Optional: read token for private datasets only.
# Never expose SANITY_API_WRITE_TOKEN or any write token to the browser.
# SANITY_API_READ_TOKEN=
